{
  "manifest_version": 3,
  "name": "NewsLiquid 高分播报",
  "version": "0.5.2",
  "description": "劫持 NewsLiquid 页面推送，高分新闻实时语音播报：消息源 + 多空方向 + AI评分 + 关联品种中文名（浏览器内置语音，零延迟不联网）",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NewsLiquid 高分播报"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.newsliquid.com/*",
        "*://*.newsliquid.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://app.newsliquid.com/*",
        "*://*.newsliquid.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
